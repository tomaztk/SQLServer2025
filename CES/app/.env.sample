# Copy to .env, adjust, then:  set -a; . ./.env; set +a; npm start
# (PowerShell: Get-Content .env | % { if ($_ -match '^(\w+)=(.*)$') { Set-Item "env:$($Matches[1])" $Matches[2] } })

# live = read from Event Hubs, mock = UI preview with in-process synthetic events
DEMO_MODE=live
PORT=8080

EVENTHUB_FQDN=evhns-cesdemo-xxxxxx.servicebus.windows.net
EVENTHUB_NAME=sql-changes
EVENTHUB_CONSUMER_GROUP=dashboard
# latest | earliest  (earliest replays the hub's retention on first start)
EVENTHUB_START_POSITION=latest
CHECKPOINT_BLOB_ENDPOINT=https://stcesdemoxxxxxx.blob.core.windows.net/
CHECKPOINT_CONTAINER=checkpoints

# The simulator writes to SQL Server; it must be reachable from where the app runs
SQL_SERVER=10.0.0.4
SQL_DATABASE=CesDemo
SQL_USER=ces_simulator
SQL_PASSWORD=
SQL_TRUST_SERVER_CERTIFICATE=true

CES_STREAM_GROUP=CesDemoGroup
SIMULATOR_AUTOSTART=false
ADMIN_TOKEN=
